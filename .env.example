# Server Configuration
PORT=5000
NODE_ENV=development

# Database (Supabase PostgreSQL)
# Example: postgresql://postgres.xxxx:your-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Authentication (GitHub OAuth)
# Get these from GitHub Developer Settings -> OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cloudflare Configuration
# If using Cloudflare R2 for Storage
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=

# If using Cloudflare Pages / Workers
# Deployment is typically handled via GitHub integration on Cloudflare's dashboard.
